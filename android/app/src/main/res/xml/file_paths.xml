<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- External files directory -->
    <external-files-path name="external_files" path="." />
    <!-- External cache directory -->
    <external-cache-path name="external_cache" path="." />
    <!-- Internal cache directory -->
    <cache-path name="cache" path="." />
    <!-- Documents directory -->
    <external-files-path name="documents" path="Documents/" />
    <!-- Root of external files -->
    <external-files-path name="root" path="." />
    <!-- Shared storage (/sdcard): the user-visible home directory, so files
         anywhere in shared storage can be shared via FileProvider content://
         URIs. Note: direct file:// URIs are blocked by scoped storage on
         Android 10+; FileProvider URIs are the supported mechanism. -->
    <external-path name="shared_storage" path="." />
</paths>